 ;
    
    
    insert into "tweedekamer"."silver"."zaak_agendapunt" 
  (
    
      
      zaak_id ,
    
      
      agendapunt_id 
    
  )
 (
      
    select zaak_id, agendapunt_id
    from (
        
WITH links AS (
    SELECT DISTINCT parent.id AS zaak_id, ref AS agendapunt_id
    FROM "tweedekamer"."bronze"."zaak__agendapunt" link
    JOIN "tweedekamer"."bronze"."zaak" parent ON link._dlt_parent_id = parent._dlt_id
    WHERE ref IS NOT NULL
)
SELECT links.* FROM links
JOIN "tweedekamer"."silver"."zaak" zaak ON links.zaak_id = zaak.id
JOIN "tweedekamer"."silver"."agendapunt" agendapunt ON links.agendapunt_id = agendapunt.id
    ) as model_subq
    );
  
  
