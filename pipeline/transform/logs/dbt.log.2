        - ((CAST(substr(periode__tot_en_met, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}$')
            THEN CAST(
(
    DATE (substr(periode__tot_en_met, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__tot_en_met, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__tot_en_met, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)
 + INTERVAL '6 days' AS DATE)
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}$')
            THEN CAST(periode__tot_en_met || '-12-31' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS periode_tot_en_met_parsed,
        periode__tot_en_met AS periode_tot_en_met_ruw,
        vergoeding__soort AS vergoeding_soort,
        vergoeding__toelichting AS vergoeding_toelichting,
        CAST(gewicht AS INTEGER) AS gewicht,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."persoon_nevenfunctie"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        id,
