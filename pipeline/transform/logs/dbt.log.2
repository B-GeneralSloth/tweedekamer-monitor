    create  table
      "tweedekamer"."silver"."persoon_loopbaan"
  
  (
    id VARCHAR,
    persoon_id VARCHAR,
    functie VARCHAR,
    werkgever VARCHAR,
    omschrijving_nl VARCHAR,
    omschrijving_en VARCHAR,
    plaats VARCHAR,
    van DATE,
    van_ruw VARCHAR,
    van_precisie VARCHAR,
