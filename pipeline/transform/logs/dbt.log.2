        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    INNER JOIN "tweedekamer"."silver"."fractie_zetel" AS seat
        ON latest.fractie_zetel_id = seat.id
    INNER JOIN "tweedekamer"."silver"."persoon" AS person
        ON latest.persoon_id = person.id
