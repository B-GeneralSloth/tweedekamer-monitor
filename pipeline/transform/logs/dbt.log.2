    create  table
      "tweedekamer"."silver"."zaal"
  
  (
    id VARCHAR,
    naam VARCHAR,
    sys_code INTEGER,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."zaal" 
  (
    
      
      id ,
    
      
      naam ,
    
      
      sys_code ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, naam, sys_code, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        naam,
        CAST(sys_code AS INTEGER) AS sys_code,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."zaal"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        id,
        naam,
        sys_code,
        gewijzigd_op,
        api_gewijzigd_op
    FROM latest
    WHERE NOT verwijderd
        
)

SELECT
    id,
    naam,
    sys_code,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as model_subq
    );
  
  
