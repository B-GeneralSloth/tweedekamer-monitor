    create  table
      "tweedekamer"."silver"."persoon_onderwijs"
  
  (
    id VARCHAR,
    persoon_id VARCHAR,
    opleiding_nl VARCHAR,
    opleiding_en VARCHAR,
    instelling VARCHAR,
    plaats VARCHAR,
    van DATE,
    van_ruw VARCHAR,
    van_precisie VARCHAR,
    tot_en_met DATE,
    tot_en_met_ruw VARCHAR,
    tot_en_met_precisie VARCHAR,
    gewicht INTEGER,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (persoon_id) references silver.persoon (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."persoon_onderwijs" 
  (
    
      
      id ,
    
      
      persoon_id ,
    
      
      opleiding_nl ,
    
      
      opleiding_en ,
    
      
      instelling ,
    
      
      plaats ,
    
      
      van ,
    
      
      van_ruw ,
    
      
      van_precisie ,
    
      
      tot_en_met ,
    
      
      tot_en_met_ruw ,
    
      
      tot_en_met_precisie ,
    
      
      gewicht ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, persoon_id, opleiding_nl, opleiding_en, instelling, plaats, van, van_ruw, van_precisie, tot_en_met, tot_en_met_ruw, tot_en_met_precisie, gewicht, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        persoon__ref AS persoon_id,
        opleiding_nl,
        opleiding_en,
        instelling,
        plaats,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(van, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(van AS DATE)
        WHEN regexp_matches(van, '^\d{4}-\d{2}$')
            THEN CAST(van || '-01' AS DATE)
        WHEN regexp_matches(van, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(van, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(van, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(van, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(van, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(van, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(van, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(van, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(van, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(van, '^\d{4}$')
            THEN CAST(van || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(van, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(van, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(van, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(van, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(van, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS van_parsed,
        van AS van_ruw,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(tot_en_met, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(tot_en_met AS DATE)
        WHEN regexp_matches(tot_en_met, '^\d{4}-\d{2}$')
            THEN last_day(CAST(tot_en_met || '-01' AS DATE))
        WHEN regexp_matches(tot_en_met, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(tot_en_met, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(tot_en_met, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(tot_en_met, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(tot_en_met, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(tot_en_met, '^\d{4}-W\d{2}$')
            THEN CAST(
(
    DATE (substr(tot_en_met, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(tot_en_met, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(tot_en_met, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)
 + INTERVAL '6 days' AS DATE)
        WHEN regexp_matches(tot_en_met, '^\d{4}$')
            THEN CAST(tot_en_met || '-12-31' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(tot_en_met, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(tot_en_met, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(tot_en_met, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(tot_en_met, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(tot_en_met, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS tot_en_met_parsed,
        tot_en_met AS tot_en_met_ruw,
        CAST(gewicht AS INTEGER) AS gewicht,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."persoon_onderwijs"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        latest.id,
        latest.persoon_id,
        latest.opleiding_nl,
        latest.opleiding_en,
        latest.instelling,
        latest.plaats,
        latest.van_parsed.datum AS van,
        latest.van_ruw,
        latest.van_parsed.precisie AS van_precisie,
        latest.tot_en_met_parsed.datum AS tot_en_met,
        latest.tot_en_met_ruw,
        latest.tot_en_met_parsed.precisie AS tot_en_met_precisie,
        latest.gewicht,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    INNER JOIN "tweedekamer"."silver"."persoon" AS parent
        ON latest.persoon_id = parent.id
    WHERE NOT verwijderd
        
)

SELECT
    id,
    persoon_id,
    opleiding_nl,
    opleiding_en,
    instelling,
    plaats,
    van,
    van_ruw,
    van_precisie,
    tot_en_met,
    tot_en_met_ruw,
    tot_en_met_precisie,
    gewicht,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as model_subq
    );
  
  
