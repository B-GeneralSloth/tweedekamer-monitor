WITH latest AS (
    SELECT
        id,
        titel,
        citeertitel,
        alias,
        CAST(nummer AS INTEGER) AS nummer,
        toevoeging,
        CAST(hoogste_volgnummer AS INTEGER) AS hoogste_volgnummer,
        afgesloten,
        kamer,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."kamerstukdossier"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        id,
        titel,
        citeertitel,
        alias,
        nummer,
        toevoeging,
        hoogste_volgnummer,
        afgesloten,
        kamer,
        gewijzigd_op,
        api_gewijzigd_op
    FROM latest
    WHERE NOT verwijderd
        
        AND latest.api_gewijzigd_op > (SELECT MAX(api_gewijzigd_op) FROM "tweedekamer"."silver"."kamerstukdossier")
        
)

SELECT
    id,
    titel,
    citeertitel,
    alias,
    nummer,
    toevoeging,
    hoogste_volgnummer,
    afgesloten,
    kamer,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as __dbt_sbq
    where false
    limit 0
)
