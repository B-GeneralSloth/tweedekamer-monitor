DESCRIBE (select * from (
        

WITH latest AS (
    SELECT
        id,
        persoon__ref AS persoon_id,
        soort,
        waarde,
        CAST(gewicht AS INTEGER) AS gewicht,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."persoon_contactinformatie"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        id,
        persoon_id,
        soort,
        waarde,
        gewicht,
        gewijzigd_op,
        api_gewijzigd_op
    FROM latest
    WHERE NOT verwijderd
        
        AND api_gewijzigd_op > (SELECT MAX(api_gewijzigd_op) FROM "tweedekamer"."silver"."persoon_contactinformatie")
        
)

SELECT
    id,
    persoon_id,
    soort,
    waarde,
    gewicht,
    gewijzigd_op,
    api_gewijzigd_op
