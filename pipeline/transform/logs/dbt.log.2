    GROUP BY 1
),

latest AS (
    SELECT
        d.id,
        d.content_type,
        d.content_length,
        d.soort,
        d.document_nummer,
        d.titel,
        d.onderwerp,
        CAST(d.datum AS DATE) AS datum,
        d.volgnummer,
        d.vergaderjaar,
        d.kamer,
        CAST(d.datum_registratie AS DATE) AS datum_registratie,
