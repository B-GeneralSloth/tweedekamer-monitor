  (
    id VARCHAR,
    activiteit_id VARCHAR,
    nummer VARCHAR,
    onderwerp VARCHAR,
    aanvangstijd TIMESTAMP,
    eindtijd TIMESTAMP,
    volgorde INTEGER,
    rubriek VARCHAR,
    noot VARCHAR,
    status VARCHAR,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (activiteit_id) references silver.activiteit (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."agendapunt" 
  (
    
      
      id ,
    
      
      activiteit_id ,
    
      
      nummer ,
    
      
      onderwerp ,
    
      
      aanvangstijd ,
    
      
      eindtijd ,
    
      
      volgorde ,
    
      
      rubriek ,
    
      
      noot ,
    
      
      status ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, activiteit_id, nummer, onderwerp, aanvangstijd, eindtijd, volgorde, rubriek, noot, status, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        activiteit__ref AS activiteit_id,
        nummer,
        onderwerp,
        CAST(aanvangstijd AS TIMESTAMP) AS aanvangstijd,
        CAST(eindtijd AS TIMESTAMP) AS eindtijd,
        CAST(volgorde AS INTEGER) AS volgorde,
        rubriek,
        noot,
        status,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."agendapunt"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        latest.id,
        latest.activiteit_id,
        latest.nummer,
        latest.onderwerp,
        latest.aanvangstijd,
        latest.eindtijd,
        latest.volgorde,
        latest.rubriek,
        latest.noot,
        latest.status,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    INNER JOIN "tweedekamer"."silver"."activiteit" AS activity
        ON latest.activiteit_id = activity.id
    WHERE NOT latest.verwijderd
        
)

SELECT
    id,
    activiteit_id,
    nummer,
    onderwerp,
    aanvangstijd,
    eindtijd,
    volgorde,
    rubriek,
    noot,
    status,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as model_subq
    );
  
  
