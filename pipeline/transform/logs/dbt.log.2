    create  table
      "tweedekamer"."silver"."document_actor"
  
  (
    id VARCHAR,
    actor_naam VARCHAR,
    functie VARCHAR,
    relatie VARCHAR,
    sid_actor VARCHAR,
    persoon_id VARCHAR,
    document_id VARCHAR,
    actor_fractie VARCHAR,
    fractie_id VARCHAR,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (document_id) references silver.document (id),
    foreign key (persoon_id) references silver.persoon (id),
    foreign key (fractie_id) references silver.fractie (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."document_actor" 
  (
    
      
      id ,
    
      
      actor_naam ,
    
      
      functie ,
    
      
      relatie ,
    
      
      sid_actor ,
    
      
      persoon_id ,
    
      
      document_id ,
    
      
      actor_fractie ,
    
      
      fractie_id ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, actor_naam, functie, relatie, sid_actor, persoon_id, document_id, actor_fractie, fractie_id, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        a.id,
        a.actor_naam,
        a.functie,
        a.relatie,
        a.sid_actor,
        a.persoon__ref AS persoon_id,
        a.document__ref AS document_id,
        a.actor_fractie,
        a.fractie__ref AS fractie_id,
        a.verwijderd,
        a.bijgewerkt AS gewijzigd_op,
        a.feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."document_actor" AS a
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY a.id
        ORDER BY a.bijgewerkt DESC, a.feed_updated DESC, a._dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT latest.* EXCLUDE (verwijderd)
    FROM latest
    JOIN "tweedekamer"."silver"."document" AS document ON latest.document_id = document.id
    LEFT JOIN "tweedekamer"."silver"."persoon" AS person ON latest.persoon_id = person.id
    LEFT JOIN "tweedekamer"."silver"."fractie" AS faction ON latest.fractie_id = faction.id
    WHERE NOT latest.verwijderd
      AND (latest.persoon_id IS NULL OR person.id IS NOT NULL)
      AND (latest.fractie_id IS NULL OR faction.id IS NOT NULL)
        
)

SELECT * FROM incoming
    ) as model_subq
    );
  
  
