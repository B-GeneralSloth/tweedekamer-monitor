    create  table
      "tweedekamer"."silver"."document_publicatie_metadata"
  
  (
    id VARCHAR,
    content_type VARCHAR,
    content_length BIGINT,
    identifier VARCHAR,
    document_type VARCHAR,
    file_name VARCHAR,
    source VARCHAR,
    publicatie_datum DATE,
    url VARCHAR,
    document_url VARCHAR,
    document_versie_id VARCHAR,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (document_versie_id) references silver.document_versie (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."document_publicatie_metadata" 
  (
    
      
      id ,
    
      
      content_type ,
    
      
      content_length ,
    
      
      identifier ,
    
      
      document_type ,
    
      
      file_name ,
    
      
      source ,
    
      
      publicatie_datum ,
    
      
      url ,
    
      
      document_url ,
    
      
      document_versie_id ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, content_type, content_length, identifier, document_type, file_name, source, publicatie_datum, url, document_url, document_versie_id, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH links AS (
    SELECT
        _dlt_parent_id,
        MAX(CASE WHEN rel = 'enclosure' THEN href END) AS document_url
    FROM "tweedekamer"."bronze"."document_publicatie_metadata__atom_links"
    GROUP BY 1
),

latest AS (
    SELECT
        m.id,
        m.content_type,
        m.content_length,
        m.identifier,
        m.document_type,
        m.file_name,
        m.source,
        CAST(m.publicatie_datum AS DATE) AS publicatie_datum,
        m.url,
        l.document_url,
        m.document_versie__ref AS document_versie_id,
        m.verwijderd,
        m.bijgewerkt AS gewijzigd_op,
        m.feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."document_publicatie_metadata" AS m
    LEFT JOIN links AS l ON m._dlt_id = l._dlt_parent_id
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY m.id
        ORDER BY m.bijgewerkt DESC, m.feed_updated DESC, m._dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT latest.* EXCLUDE (verwijderd)
    FROM latest
    JOIN "tweedekamer"."silver"."document_versie" AS version
        ON latest.document_versie_id = version.id
    WHERE NOT latest.verwijderd
        
)

SELECT * FROM incoming
    ) as model_subq
    );
  
  
