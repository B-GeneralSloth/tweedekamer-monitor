 (
      
    select id, soort, nummer, onderwerp, datum_soort, datum, aanvangstijd, eindtijd, locatie, besloten, status, vergaderjaar, kamer, noot, vrs_nummer, sid_voortouw, voortouwnaam, voortouwafkorting, voortouwkortenaam, voortouwcommissie_id, aanvraagdatum, datum_verzoek_eerste_verlenging, datum_mededeling_eerste_verlenging, datum_verzoek_tweede_verlenging, datum_mededeling_tweede_verlenging, vervaldatum, gewijzigd_op, api_gewijzigd_op
    from (
        

