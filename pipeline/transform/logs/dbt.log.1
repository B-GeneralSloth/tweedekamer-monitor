    create  table
      "tweedekamer"."silver"."toezegging_toegezegd_aan"
  
  (
    toezegging_id VARCHAR,
    volgorde INTEGER,
    persoon_id VARCHAR,
    fractie_id VARCHAR,
    
    primary key (toezegging_id, volgorde),
    foreign key (toezegging_id) references silver.toezegging (id),
    foreign key (persoon_id) references silver.persoon (id),
    foreign key (fractie_id) references silver.fractie (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."toezegging_toegezegd_aan" 
  (
    
      
      toezegging_id ,
    
      
      volgorde ,
    
      
      persoon_id ,
    
      
      fractie_id 
    
  )
 (
      
    select toezegging_id, volgorde, persoon_id, fractie_id
    from (
        

WITH current_toezeggingen AS (
    SELECT id, _dlt_id
    FROM "tweedekamer"."bronze"."toezegging"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
       AND NOT verwijderd
),
links AS (
    SELECT DISTINCT
        parent.id AS toezegging_id,
        CAST(link._dlt_list_idx AS INTEGER) AS volgorde,
        link.persoon__ref AS persoon_id,
        link.fractie__ref AS fractie_id
    FROM "tweedekamer"."bronze"."toezegging__toegezegd_aan" AS link
    JOIN current_toezeggingen AS parent ON link._dlt_parent_id = parent._dlt_id
)

SELECT
    links.toezegging_id,
    links.volgorde,
    links.persoon_id,
    links.fractie_id
FROM links
JOIN "tweedekamer"."silver"."toezegging" AS toezegging ON links.toezegging_id = toezegging.id
LEFT JOIN "tweedekamer"."silver"."persoon" AS persoon ON links.persoon_id = persoon.id
LEFT JOIN "tweedekamer"."silver"."fractie" AS fractie ON links.fractie_id = fractie.id
WHERE (links.persoon_id IS NULL OR persoon.id IS NOT NULL)
  AND (links.fractie_id IS NULL OR fractie.id IS NOT NULL)
    ) as model_subq
    );
  
  
