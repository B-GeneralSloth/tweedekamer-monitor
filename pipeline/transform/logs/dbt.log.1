    agendapunt_zaak_besluit_volgorde INTEGER,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (agendapunt_id) references silver.agendapunt (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."besluit" 
  (
    
      
      id ,
    
      
      agendapunt_id ,
    
      
      stemmings_soort ,
    
      
      besluit_soort ,
    
      
      besluit_tekst ,
    
      
      opmerking ,
    
      
      status ,
    
      
      agendapunt_zaak_besluit_volgorde ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, agendapunt_id, stemmings_soort, besluit_soort, besluit_tekst, opmerking, status, agendapunt_zaak_besluit_volgorde, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        agendapunt__ref AS agendapunt_id,
        stemmings_soort,
        besluit_soort,
        besluit_tekst,
        opmerking,
        status,
        CAST(agendapunt_zaak_besluit_volgorde AS INTEGER) AS agendapunt_zaak_besluit_volgorde,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
