WITH links AS (
    SELECT
        _dlt_parent_id,
        MAX(CASE WHEN rel = 'enclosure' THEN href END) AS document_url
    FROM "tweedekamer"."bronze"."document__atom_links"
    GROUP BY 1
),

latest AS (
    SELECT
        d.id,
        d.content_type,
        d.content_length,
        d.soort,
        d.document_nummer,
        d.titel,
        d.onderwerp,
        CAST(d.datum AS DATE) AS datum,
        d.volgnummer,
        d.vergaderjaar,
        d.kamer,
