[0m12:05:28.082190 [debug] [Thread-1 (]: On model.tweedekamer_transform.toezegging: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "tweedekamer_transform", "target_name": "local", "node_id": "model.tweedekamer_transform.toezegging"} */

    
      
    

    create  table
      "tweedekamer"."silver"."toezegging"
  
  (
    id VARCHAR,
    aanmaakdatum TIMESTAMP WITH TIME ZONE,
    nummer VARCHAR,
    activiteit_id VARCHAR,
    activiteit_nummer VARCHAR,
    naam VARCHAR,
    achternaam VARCHAR,
    initialen VARCHAR,
    tussenvoegsel VARCHAR,
    voornaam VARCHAR,
    achtervoegsel VARCHAR,
    titulatuur VARCHAR,
    functie VARCHAR,
    status VARCHAR,
    datum_nakoming TIMESTAMP WITH TIME ZONE,
    ministerie VARCHAR,
    tekst VARCHAR,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (activiteit_id) references silver.activiteit (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."toezegging" 
  (
    
      
      id ,
    
      
      aanmaakdatum ,
    
      
      nummer ,
    
      
      activiteit_id ,
    
      
      activiteit_nummer ,
    
      
      naam ,
    
      
      achternaam ,
    
      
      initialen ,
    
      
      tussenvoegsel ,
    
      
      voornaam ,
    
      
      achtervoegsel ,
    
      
      titulatuur ,
    
      
      functie ,
    
      
      status ,
    
      
      datum_nakoming ,
    
      
      ministerie ,
    
      
      tekst ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, aanmaakdatum, nummer, activiteit_id, activiteit_nummer, naam, achternaam, initialen, tussenvoegsel, voornaam, achtervoegsel, titulatuur, functie, status, datum_nakoming, ministerie, tekst, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        CAST(aanmaakdatum AS TIMESTAMP WITH TIME ZONE) AS aanmaakdatum,
        nummer,
        activiteit__ref AS activiteit_id,
        activiteit_nummer,
        naam,
        achternaam,
        initialen,
        tussenvoegsel,
        voornaam,
        achtervoegsel,
        titulatuur,
        functie,
        status,
        CAST(datum_nakoming AS TIMESTAMP WITH TIME ZONE) AS datum_nakoming,
        ministerie,
        tekst,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."toezegging"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT latest.* EXCLUDE (verwijderd)
    FROM latest
    JOIN "tweedekamer"."silver"."activiteit" AS activiteit
        ON latest.activiteit_id = activiteit.id
    WHERE NOT latest.verwijderd
        
)

SELECT * FROM incoming
    ) as model_subq
    );
  
  
