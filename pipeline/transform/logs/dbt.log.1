        latest.content_type,
        latest.content_length,
        latest.xml_url,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    LEFT JOIN "tweedekamer"."silver"."vergadering" AS meeting
        ON latest.vergadering_id = meeting.id
    WHERE NOT latest.verwijderd
        
)

