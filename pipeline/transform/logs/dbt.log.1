    insert into "tweedekamer"."silver"."zaak_vervangen_vanuit" 
  (
    
      
      zaak_id ,
    
      
      vervangen_vanuit_id 
    
  )
 (
      
    select zaak_id, vervangen_vanuit_id
    from (
        
WITH links AS (
    SELECT DISTINCT parent.id AS zaak_id, ref AS vervangen_vanuit_id
    FROM "tweedekamer"."bronze"."zaak__vervangen_vanuit" link
    JOIN "tweedekamer"."bronze"."zaak" parent ON link._dlt_parent_id = parent._dlt_id
    WHERE ref IS NOT NULL
)
SELECT links.* FROM links
JOIN "tweedekamer"."silver"."zaak" zaak ON links.zaak_id = zaak.id
JOIN "tweedekamer"."silver"."zaak" parent ON links.vervangen_vanuit_id = parent.id
    ) as model_subq
    );
  
  
