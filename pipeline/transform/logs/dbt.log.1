    FROM "tweedekamer"."bronze"."zaak_actor"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        latest.id,
        CASE WHEN zaak.id IS NOT NULL THEN latest.zaak_id END AS zaak_id,
        CASE WHEN person.id IS NOT NULL THEN latest.persoon_id END AS persoon_id,
        CASE WHEN faction.id IS NOT NULL THEN latest.fractie_id END AS fractie_id,
        CASE WHEN committee.id IS NOT NULL THEN latest.commissie_id END AS commissie_id,
        latest.actor_naam,
        latest.actor_fractie,
        latest.actor_afkorting,
        latest.functie,
        latest.relatie,
        latest.sid_actor,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    LEFT JOIN "tweedekamer"."silver"."zaak" AS zaak ON latest.zaak_id = zaak.id
    LEFT JOIN "tweedekamer"."silver"."persoon" AS person ON latest.persoon_id = person.id
    LEFT JOIN "tweedekamer"."silver"."fractie" AS faction ON latest.fractie_id = faction.id
    LEFT JOIN "tweedekamer"."silver"."commissie" AS committee ON latest.commissie_id = committee.id
    WHERE NOT latest.verwijderd
        
)

