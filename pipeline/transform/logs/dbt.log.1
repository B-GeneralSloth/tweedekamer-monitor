            THEN CAST(periode__van AS DATE)
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}$')
            THEN CAST(periode__van || '-01' AS DATE)
        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(periode__van, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__van, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__van, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(periode__van, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(periode__van, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__van, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__van, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(periode__van, '^\d{4}$')
            THEN CAST(periode__van || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(periode__van, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS periode_van_parsed,
