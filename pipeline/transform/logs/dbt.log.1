),

incoming AS (
    SELECT
        latest.id,
        CASE WHEN activity.id IS NOT NULL THEN latest.activiteit_id END AS activiteit_id,
        latest.nummer,
        latest.onderwerp,
        latest.aanvangstijd,
        latest.eindtijd,
        latest.volgorde,
        latest.rubriek,
        latest.noot,
        latest.status,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    LEFT JOIN "tweedekamer"."silver"."activiteit" AS activity
        ON latest.activiteit_id = activity.id
    WHERE NOT latest.verwijderd
        
        AND latest.api_gewijzigd_op > (SELECT MAX(api_gewijzigd_op) FROM "tweedekamer"."silver"."agendapunt")
        
)

SELECT
