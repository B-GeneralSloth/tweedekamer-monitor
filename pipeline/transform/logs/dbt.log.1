    create  table
      "tweedekamer"."silver"."persoon_nevenfunctie"
  
  (
    id VARCHAR,
    persoon_id VARCHAR,
    omschrijving VARCHAR,
    is_actief BOOLEAN,
    periode_van DATE,
    periode_van_ruw VARCHAR,
    periode_van_precisie VARCHAR,
    periode_tot_en_met DATE,
    periode_tot_en_met_ruw VARCHAR,
    periode_tot_en_met_precisie VARCHAR,
    vergoeding_soort VARCHAR,
    vergoeding_toelichting VARCHAR,
    gewicht INTEGER,
    gewijzigd_op TIMESTAMP WITH TIME ZONE,
    api_gewijzigd_op TIMESTAMP WITH TIME ZONE,
    
    primary key (id),
    foreign key (persoon_id) references silver.persoon (id)
    )
 ;
    
    
    insert into "tweedekamer"."silver"."persoon_nevenfunctie" 
  (
    
      
      id ,
    
      
      persoon_id ,
    
      
      omschrijving ,
    
      
      is_actief ,
    
      
      periode_van ,
    
      
      periode_van_ruw ,
    
      
      periode_van_precisie ,
    
      
      periode_tot_en_met ,
    
      
      periode_tot_en_met_ruw ,
    
      
      periode_tot_en_met_precisie ,
    
      
      vergoeding_soort ,
    
      
      vergoeding_toelichting ,
    
      
      gewicht ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, persoon_id, omschrijving, is_actief, periode_van, periode_van_ruw, periode_van_precisie, periode_tot_en_met, periode_tot_en_met_ruw, periode_tot_en_met_precisie, vergoeding_soort, vergoeding_toelichting, gewicht, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        persoon__ref AS persoon_id,
        omschrijving,
        is_actief,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(periode__van AS DATE)
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}$')
            THEN CAST(periode__van || '-01' AS DATE)
        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(periode__van, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__van, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__van, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(periode__van, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(periode__van, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__van, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__van, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(periode__van, '^\d{4}$')
            THEN CAST(periode__van || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(periode__van, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(periode__van, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(periode__van, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS periode_van_parsed,
        periode__van AS periode_van_ruw,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(periode__tot_en_met AS DATE)
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}$')
            THEN last_day(CAST(periode__tot_en_met || '-01' AS DATE))
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(periode__tot_en_met, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__tot_en_met, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__tot_en_met, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(periode__tot_en_met, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}$')
            THEN CAST(
(
    DATE (substr(periode__tot_en_met, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(periode__tot_en_met, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(periode__tot_en_met, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)
 + INTERVAL '6 days' AS DATE)
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}$')
            THEN CAST(periode__tot_en_met || '-12-31' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS periode_tot_en_met_parsed,
        periode__tot_en_met AS periode_tot_en_met_ruw,
        vergoeding__soort AS vergoeding_soort,
        vergoeding__toelichting AS vergoeding_toelichting,
        CAST(gewicht AS INTEGER) AS gewicht,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."persoon_nevenfunctie"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        id,
        persoon_id,
        omschrijving,
        is_actief,
        periode_van_parsed.datum AS periode_van,
        periode_van_ruw,
        periode_van_parsed.precisie AS periode_van_precisie,
        periode_tot_en_met_parsed.datum AS periode_tot_en_met,
        periode_tot_en_met_ruw,
        periode_tot_en_met_parsed.precisie AS periode_tot_en_met_precisie,
        vergoeding_soort,
        vergoeding_toelichting,
        gewicht,
        gewijzigd_op,
        api_gewijzigd_op
    FROM latest
    WHERE NOT verwijderd
        
)

SELECT
    id,
    persoon_id,
    omschrijving,
    is_actief,
    periode_van,
    periode_van_ruw,
    periode_van_precisie,
    periode_tot_en_met,
    periode_tot_en_met_ruw,
    periode_tot_en_met_precisie,
    vergoeding_soort,
    vergoeding_toelichting,
    gewicht,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as model_subq
    );
  
  
