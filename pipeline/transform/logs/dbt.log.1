    persoon_id,
    omschrijving,
    datum,
    datum_ruw,
    datum_precisie,
    gewicht,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as __dbt_sbq
    where false
    limit 0
)
