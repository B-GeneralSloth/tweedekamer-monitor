        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(periode__tot_en_met, '^\d{4}$') THEN 'jaar'
