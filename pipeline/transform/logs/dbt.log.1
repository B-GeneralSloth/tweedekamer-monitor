WITH latest AS (
    SELECT
        id,
        activiteit__ref AS activiteit_id,
        nummer,
        onderwerp,
        CAST(aanvangstijd AS TIMESTAMP) AS aanvangstijd,
        CAST(eindtijd AS TIMESTAMP) AS eindtijd,
        CAST(volgorde AS INTEGER) AS volgorde,
        rubriek,
        noot,
        status,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
