      rubriek ,
    
      
      noot ,
    
      
      status ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
 (
      
    select id, activiteit_id, nummer, onderwerp, aanvangstijd, eindtijd, volgorde, rubriek, noot, status, gewijzigd_op, api_gewijzigd_op
    from (
        

WITH latest AS (
    SELECT
        id,
        activiteit__ref AS activiteit_id,
        nummer,
        onderwerp,
        CAST(aanvangstijd AS TIMESTAMP) AS aanvangstijd,
        CAST(eindtijd AS TIMESTAMP) AS eindtijd,
        CAST(volgorde AS INTEGER) AS volgorde,
